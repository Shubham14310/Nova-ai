{
  "expo": {
    "name": "Nova AI",
    "slug": "nova-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.novaai.assistant",
      "permissions": [
        "INTERNET"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "apiBaseUrl": "https://nova-ai-aqj1.onrender.com",
      "eas": {
        "projectId": "ccb3c978-b949-416c-bf1a-d04410f327f2"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/nova-splash.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#090D1F",
          "dark": {
            "backgroundColor": "#090D1F"
          }
        }
      ]
    ],
    "icon": "./assets/nova-icon.png"
  }
}
